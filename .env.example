# Settings for compose.yaml: copy this to .env and fill it in (docs/docker.md).

# How people reach this Pond: what invite links say. Forward port 443, TCP and UDP, to this machine. Add :port only if
# POND_CHAT_PORT below isn't 443.
POND_ADDRESS=pond.example.org

# The Pond's name, given to it on the first start (change it later with pondctl).
POND_NAME=My Pond

# The database password: anything long and random. Nothing outside the two containers uses it.
POND_DB_PASSWORD=change-me-to-something-long

# Which build: the newest release (latest), a version (0.1.0), or the newest build of the dev branch (dev).
POND_IMAGE=ghcr.io/ezp2p/pond:latest

# The chat port (TCP: everything but voice) and the voice port (UDP: voice and video). Both 443 unless set; change one
# only if something else has it, such as a reverse proxy on TCP 443 (docs/docker.md, "Behind a reverse proxy").
# POND_CHAT_PORT=443
# POND_VOICE_PORT=443
